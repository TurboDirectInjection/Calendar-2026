				(size 1.27 1.27)
			)
		)
		(uuid "3ffab29d-9e75-4250-ab17-a30188078f19")
	)
	(text "C_{stray} = 5 pF (approx)\nC_{L} = 9 pF\nC_{1} = C_{2} \n   = 2(C_{L} - C_{stray})\n   = 8 pF"
